# EasyMoney environment. Copy to `.env` and adjust. All defaults work locally.
# See README.md "Environment" for the full reference.

# --- Database ---
POSTGRES_USER=easymoney
POSTGRES_PASSWORD=easymoney
POSTGRES_DB=easymoney
# Explicit override (composed from the three above when empty):
#DATABASE_URL=postgresql+asyncpg://easymoney:easymoney@db:5432/easymoney

# --- Auth ---
# Boot guard (A-8): with DEBUG=false (the default) the app refuses to start
# unless a strong secret is set; empty + DEBUG=true auto-generates one per
# boot (sessions die on restart). A secret shorter than 32 chars or a known
# dev default warns under DEBUG and fails otherwise.
# The value below is a placeholder so the one-command launch works out of the
# box — replace it with your own (python -c "import secrets;print(secrets.token_hex(32))").
JWT_SECRET=dc3f87f11d919ad058874dd2e490a33a83e865144b80bded46eaca346fb21459
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- Debug & mail ---
# Off by default: no SQL echo and the strict JWT_SECRET guard apply. Set true
# only for verbose local debugging.
DEBUG=false
# Mount the API docs (Swagger at /api/docs, ReDoc at /api/redoc, spec at
# /api/openapi.json). Off by default; set true to enable them for local dev.
EXPOSE_API_DOCS=false
# Real SMTP (leave SMTP_HOST empty for log-only mail in dev):
#SMTP_HOST=
#SMTP_PORT=1025
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_USE_TLS=false
# To use the bundled mailpit for inspection: SMTP_HOST=mailpit, SMTP_PORT=1025
# Master switch for all outbound mail. false = never send (log only), and all
# confirmation flows are skipped (register, email + password change apply
# immediately).
SMTP_ENABLED=true
# Require email confirmation after registration (active only when SMTP_ENABLED=true).
EMAIL_REGISTER_CONFIRMATION=false
# Require confirmation on email change (active only when SMTP_ENABLED=true).
# When on, a confirm link is mailed to the NEW address and a "this wasn't me"
# revert link to the PREVIOUS one (see EMAIL_CHANGE_REVERT_DAYS).
EMAIL_CHANGE_CONFIRMATION=false
# Require confirmation (sent to the user's email; applied only when the link
# is opened) on password change (active only when SMTP_ENABLED=true).
PASSWORD_CHANGE_CONFIRMATION=false
# How long a confirmation link stays valid, in hours. Applied to the register,
# email-change and password-change confirmation links.
CONFIRMATION_TOKEN_HOURS=24
# How long the "this wasn't me" revert link (sent to the previous address on an
# email change) stays valid, in days. Within this window the change can be
# reverted (cancelled if still pending, or switched back if already confirmed).
EMAIL_CHANGE_REVERT_DAYS=2
# When false, only the first user can register (while the users table is
# empty); after that registration is closed and the register form is hidden.
REGISTRATION_OPEN=true
# Max raw size (MB) of a user avatar upload (image stored as base64 in the DB).
MAX_AVATAR_MB=2
FRONTEND_URL=http://localhost:8081

# --- Debt reminders ---
DEBT_OVERDUE_DAYS=7
REMINDER_INTERVAL_DAYS=7

# --- Invites ---
INVITE_EXPIRY_DAYS=7

# --- Receipts / object storage ---
# Max raw size (MB) of a receipt upload (image or PDF).
MAX_UPLOAD_MB=10
# Where receipt files live: "s3" (an S3-compatible store — LocalStack in the
# compose stack, AWS S3 in production) or "local" (plain disk under UPLOAD_DIR,
# the pre-S3 behaviour). The compose stack runs "s3".
STORAGE_BACKEND=s3
# S3-compatible endpoint. The compose stack points this at the localstack
# service; for real AWS leave it empty to let boto3 use the provider default.
S3_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=easymoney-receipts
S3_REGION=us-east-1
# Dummy credentials for LocalStack. For real AWS leave both empty and let boto3
# resolve credentials from the environment (AWS_*) / IAM, or set your own keys.
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# Only used when STORAGE_BACKEND=local (bare dev / the test suite).
UPLOAD_DIR=/data/uploads

# --- Redis (cross-instance scaling) ---
# The cross-instance WebSocket event bus + small display caches (AGENTS.md
# §3.2). The compose stack points this at the `redis` service. Leave empty to
# run the single-process local mode (no Redis; exactly the pre-Redis behaviour).
# Point at a managed Redis (e.g. redis://user:pass@host:6379/0) in production
# when running more than one backend replica.
REDIS_URL=redis://redis:6379/0
# Balance-snapshot cache TTL (seconds). Each group event also refreshes the key
# with the fresh snapshot, so the TTL is only the safety net.
SNAPSHOT_CACHE_TTL_S=30
# WS-handshake group-list cache TTL (seconds). Invalidated on join/leave.
USER_GROUPS_CACHE_TTL_S=300
# Single-flight reminder-scan lock TTL (seconds). Below the 1 h interval so a
# dead holder never blocks the next run; far above any scan duration.
SCHEDULER_LOCK_TTL_S=3300

# --- Web Push (OS notifications with the app closed) ---
# VAPID key pair (base64url, no padding). Leave both EMPTY to disable Web Push
# (the app works normally; the Settings toggle shows the "unsupported" hint).
# Generate a pair with:  python backend/scripts/generate_vapid.py
# Share the same keys across all backend replicas; never commit them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to the browser when it asks to allow notifications.
VAPID_SUBJECT=mailto:admin@easymoney.local

# --- CORS (only relevant if the frontend is not behind the same nginx) ---
CORS_ORIGINS=http://localhost:8081
